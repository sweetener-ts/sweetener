{
  "name": "@sweetener/content-mapper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/src/server.js"
      ],
      "dynamicConfig": true
    }
  },
  "dependencies": {
    "@sweetener/compiler": "workspace:*"
  },
  "devDependencies": {
    "typescript7": "npm:typescript@7.1.0-beta"
  }
}
