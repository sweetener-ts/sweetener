{
  "name": "sweetener-vscode",
  "displayName": "Sweetener",
  "description": "Syntax highlighting for Sweetener's .sts and .stsx files.",
  "version": "0.1.0-alpha.0",
  "publisher": "sweetener",
  "license": "MIT",
  "engines": {
    "vscode": ">=1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:sweetener-typescript",
    "onLanguage:sweetener-typescriptreact"
  ],
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "contributes": {
    "configuration": {
      "title": "Sweetener",
      "properties": {
        "sweetener.languageServer": {
          "type": "object",
          "description": "Command that starts the Sweetener language server.",
          "properties": {
            "command": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "languages": [
      {
        "id": "sweetener-typescript",
        "aliases": [
          "Sweetener TypeScript"
        ],
        "extensions": [
          ".sts"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sweetener-typescriptreact",
        "aliases": [
          "Sweetener TSX"
        ],
        "extensions": [
          ".stsx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sweetener-typescript",
        "scopeName": "source.sweetener",
        "path": "./syntaxes/sweetener.tmLanguage.json",
        "embeddedLanguages": {
          "source.tsx": "typescriptreact"
        }
      },
      {
        "language": "sweetener-typescriptreact",
        "scopeName": "source.sweetener",
        "path": "./syntaxes/sweetener.tmLanguage.json",
        "embeddedLanguages": {
          "source.tsx": "typescriptreact"
        }
      }
    ]
  }
}
