{
  "name": "sweetener-vscode",
  "displayName": "Sweetener",
  "description": "Syntax highlighting for Sweetener's .sts and .stsx files, and TypeScript 7's language server on them through @sweetener/content-mapper.",
  "version": "0.1.0-alpha.0",
  "private": true,
  "publisher": "sweetener",
  "license": "MIT",
  "engines": {
    "vscode": ">=1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "browser": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onLanguage:sweetener-typescript",
    "onLanguage:sweetener-typescriptreact"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sweetener-typescript",
        "aliases": [
          "Sweetener TypeScript"
        ],
        "extensions": [
          ".sts"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sweetener-typescriptreact",
        "aliases": [
          "Sweetener TSX"
        ],
        "extensions": [
          ".stsx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sweetener-typescript",
        "scopeName": "source.sweetener",
        "path": "./syntaxes/sweetener.tmLanguage.json",
        "embeddedLanguages": {
          "source.tsx": "typescriptreact"
        }
      },
      {
        "language": "sweetener-typescriptreact",
        "scopeName": "source.sweetener",
        "path": "./syntaxes/sweetener.tmLanguage.json",
        "embeddedLanguages": {
          "source.tsx": "typescriptreact"
        }
      }
    ]
  }
}
